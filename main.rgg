// ---------------------------------------------------------------------------
// Batch / headless execution (GroIMP 3.x, e.g. on a cluster):
//   java -jar core.jar --headless /path/to/SC_ARC/project.gs
// When GroIMP is started headless, startup() schedules run(Object), which
// resets the scene (calls init()), repeats run() + derive() until all nrSims
// simulations are finished, then exits the JVM (exit code 1 on error).
// Optional environment variable: SCARC_MAX_STEPS (safety limit, default 100000).
// ---------------------------------------------------------------------------
protected void startup()
{
	super.startup();
	if (de.grogra.pf.boot.Main.getProperty("headless") != null) {runLater(null);}
}

protected void run(Object info)
{
	int status = 0;
	try {
		String ms = System.getenv("SCARC_MAX_STEPS");
		int maxSteps = (ms == null || ms.length() == 0) ? 100000 : Integer.parseInt(ms.trim());
		reset();	// builds the initial scene and calls init()
		derive();
		int steps = 0;
		while (sims < nrSims && steps < maxSteps) {
			run();
			derive();
			steps++;
		}
		if (sims < nrSims) {println("!! stopped after SCARC_MAX_STEPS = "+maxSteps+" steps"); status = 2;}
		println("headless run finished after "+steps+" steps");
	} catch (Throwable t) {
		t.printStackTrace();
		status = 1;
	}
	System.out.flush();
	System.exit(status);
}

public void run()
{
	// at the start initiate and clear all tables
	if (sims == 0 && time == 0) {initDatasets();}
	// simulate until end is reached
	if (end == false && time != halt) {
		step();
	} else {
		sims++;
		// change parameters and reset scene for next simulation
		if (sims < nrSims) {
			updateParameters();
			resetCounters();
			reset();
		// if all simulations are done, write output files
		} else {
			stop = System.currentTimeMillis();
			avgRate = 0.01*Math.round(100 * time / ((stop-start)/1000));
			println("average simulation rate: "+avgRate+" steps/s");
			if (writeFieldTable == true) {exportData(fieldOutput, "field");}
			if (writePlantTable == true) {exportData(plantOutput, "plant");}
			if (writeLight == true) {exportData(combiLight, "light");}
		}
	}
}

public void swColor() {
	de.grogra.imp3d.View3D view = de.grogra.imp3d.View3D.getDefaultView(workbench());
	if (sRFR == false) {sRFR = false;} else {sRFR = true;}
	view.repaint();
}

